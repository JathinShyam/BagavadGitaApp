<?xml version="1.0" encoding="utf-8"?>
<!-- Keep RemoteViews-safe: no custom fonts, letterSpacing, or layout_weight. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="16dp"
  android:paddingTop="14dp"
  android:paddingBottom="14dp"
  android:background="@drawable/widget_daily_verse_bg"
  android:contentDescription="@string/widget_daily_verse_description">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/widget_eyebrow"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/widget_eyebrow_today"
      android:textColor="@color/widget_primary"
      android:textSize="11sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end" />

    <TextView
      android:id="@+id/widget_brand"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/app_name"
      android:textColor="@color/widget_text_muted"
      android:textSize="10sp"
      android:maxLines="1"
      android:ellipsize="end" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="@string/widget_title_placeholder"
    android:textColor="@color/widget_text"
    android:textSize="17sp"
    android:textStyle="bold"
    android:maxLines="2"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/widget_sloka"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text=""
    android:textColor="@color/widget_text"
    android:textSize="13sp"
    android:maxLines="2"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/widget_meaning"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:text="@string/widget_meaning_placeholder"
    android:textColor="@color/widget_text_muted"
    android:textSize="12sp"
    android:maxLines="3"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/widget_cta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/widget_cta_open"
    android:textColor="@color/widget_primary"
    android:textSize="12sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end" />

</LinearLayout>
