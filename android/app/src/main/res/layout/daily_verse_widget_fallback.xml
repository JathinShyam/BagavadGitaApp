<?xml version="1.0" encoding="utf-8"?>
<!-- Ultra-minimal fallback if the main widget layout fails to bind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_fallback_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="16dp"
  android:background="@drawable/widget_daily_verse_bg">

  <TextView
    android:id="@+id/widget_fallback_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/widget_title_placeholder"
    android:textColor="@color/widget_text"
    android:textSize="16sp"
    android:textStyle="bold"
    android:maxLines="2" />

  <TextView
    android:id="@+id/widget_fallback_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/widget_meaning_placeholder"
    android:textColor="@color/widget_text_muted"
    android:textSize="12sp"
    android:maxLines="4" />
</LinearLayout>
